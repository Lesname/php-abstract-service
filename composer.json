{
  "name": "lesname/abstract-service",
  "license": "MIT",
  "require": {
    "php": "^8.5.0",

    "ext-openssl": "*",

    "psr/http-server-handler": "^1.0.0",

    "lesname/cache": "^0.4.3",
    "lesname/documentor": "^0.7.4",
    "lesname/database": "^0.5.6",
    "lesname/resource": "^0.7.0",
    "lesname/domain": "^0.7.7",
    "lesname/validator": "^0.6.11",
    "lesname/queue": "^0.9.3",
    "lesname/http": "^0.9.5",
    "lesname/value-object": "^0.7.1",
    "lesname/token": "^0.4.0",

    "mezzio/mezzio": "^3.20.0",
    "mezzio/mezzio-helpers": "^5.0.0",

    "laminas/laminas-cli": "^1.0.0",

    "monolog/monolog": "^3.0.0",
    "rollbar/rollbar": "~4.0",

    "symfony/console": "^7.0.0",

    "psr/http-message": "^1.0.0 || ^2.0.0",
    "psr/container": "^1.0.0 || ^2.0.0",

    "slim/psr7": "^1.7.0",

    "symfony/translation": "^7.0.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.0",

    "phpunit/phpunit": "^13.0.0",

    "vimeo/psalm": "^7.0.0-beta9",

    "php-amqplib/php-amqplib": "^3.0.0",

    "phpstan/phpstan": "^2.0.0",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "LesAbstractService\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesAbstractServiceTest\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
